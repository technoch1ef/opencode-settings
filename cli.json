{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "./plugins/oc-iterm2"
  ],
  "terminal": {
    "title": false
  },
  "theme": {
    "name": "astronvim-vivid"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "tabs": {
    "mode": "on",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "attention": {
    "notifications": true,
    "sound": true
  }
}
