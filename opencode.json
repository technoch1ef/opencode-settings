{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "mayor",
  "plugin": [
    "opencode-beads"
  ],
  "skills": {
    "paths": [
      "{env:HOME}/.config/opencode/skills-private"
    ]
  },
  "permission": {
    "bash": {
      "*": "allow",
      "bd *": "ask",
      "bd ready*": "allow",
      "bd list*": "allow",
      "bd show*": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "village_spawn": "allow",
    "village_wake": "allow"
  },
  "agent": {
    "github": {
      "description": "GitHub-focused agent for repository management, PRs, issues, and automation",
      "prompt": "You are a GitHub expert. Help with repository management, pull requests, issue triage, branch management, and GitHub automation. Use GitHub tools to perform operations. Always provide clear feedback about what was done and next steps.",
      "tools": {
        "bash": true,
        "edit": true,
        "write": true,
        "read": true,
        "grep": true,
        "glob": true,
        "github_*": true,
        "gh_*": true
      }
    }
  },
  "instructions": [
    ".opencode/github-rules.md"
  ],
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true,
      "timeout": 30000
    }
  }
}
