{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "mayor",
  "plugin": ["@mohak34/opencode-notifier@latest", "opencode-beads"],
  "skills": {
    "paths": ["{env:HOME}/.config/opencode/skills-private"]
  },
  "permission": {
    "bash": {
      "*": "allow",
      "br *": "ask",
      "br ready*": "allow",
      "br list*": "allow",
      "br show*": "allow"
    },
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "github": {
      "disable": true
    }
  },
  "instructions": [".opencode/github-rules.md"]
}
