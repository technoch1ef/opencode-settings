{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "mayor",
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "@technoch1ef/opencode-beads-rust",
    "@technoch1ef/opencode-village",
    "opencode-copilot-1m"
  ],
  "skills": {
    "paths": ["{env:HOME}/.config/opencode/skills-private"]
  },
  "permission": {
    "bash": {
      "*": "allow",
      "br *": "ask",
      "br ready*": "allow",
      "br list*": "allow",
      "br show*": "allow"
    },
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "github": {
      "disable": true
    }
  },
  "instructions": [".opencode/github-rules.md"]
}
