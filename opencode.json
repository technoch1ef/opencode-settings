{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "mayor",
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    [
      "@technoch1ef/opencode-beads-rust@0.2.0",
      { "inject": ["mayor", "worker", "guard", "inspector", "envoy"] }
    ],
    "@technoch1ef/opencode-village@0.7.0",
    "opencode-copilot-1m",
    "opencode-with-claude@1.9.1"
  ],
  "skills": {
    "paths": ["{env:HOME}/.config/opencode/skills-private"]
  },
  // Village tools are hidden by default; re-enabled per-agent in
  // agents/{mayor,worker,guard,inspector,envoy}.md frontmatter.
  "tools": {
    "village_*": false
  },
  "permission": {
    "bash": {
      "*": "allow",
      "br *": "ask",
      "br ready*": "allow",
      "br list*": "allow",
      "br show*": "allow"
    },
    "skill": {
      "*": "allow",
      "village-workflow": "deny"
    }
  },
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy-api-key"
      }
    }
  },
  "agent": {
    "github": {
      "disable": true
    }
  },
  "instructions": [".opencode/github-rules.md"]
}
